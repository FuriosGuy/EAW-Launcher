<dialogs:WindowHost x:Class="FocLauncherHost.Dialogs.RestartElevatedWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dialogs="clr-namespace:FocLauncherHost.Dialogs"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="560"
             Width="560" Height="320" MinHeight="320" Background="Transparent" Foreground="{DynamicResource TextBrush}"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <FrameworkElement.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="104"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="16,6"/><Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/></Trigger>
                            <Trigger Property="IsCancel" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PanelBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </FrameworkElement.Resources>

    <Border Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="14" SnapsToDevicePixels="True">
        <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.42" Color="#FF000000"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" CornerRadius="14,14,0,0" Padding="16,10" MouseLeftButtonDown="MoveWindow">
                <StackPanel>
                    <TextBlock Text="EMPIRE AT WAR Launcher" Foreground="{DynamicResource TitleBarTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Administrator permission required" Foreground="{DynamicResource TitleBarTextBrush}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="1" Margin="24,22,24,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="62" Height="62" CornerRadius="12" Background="{DynamicResource IconBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" VerticalAlignment="Top">
                    <TextBlock Text="↻" Foreground="{DynamicResource PrimaryBrush}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Update needs elevated access" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Administrator rights are required to replace protected launcher files. Restart with elevated access to continue." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Border HorizontalAlignment="Left" Background="{DynamicResource SelectedBrush}" CornerRadius="8" Padding="10,5" Margin="0,12,0,0">
                        <TextBlock Text="SAFE UPDATE RESTART" Foreground="{DynamicResource SelectionTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,14,14" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button IsDefault="True" Content="Run as Administrator" Style="{StaticResource DialogButton}" Click="OnRestartClick"/>
                    <Button IsCancel="True" Content="_Abort Update" Style="{StaticResource DialogButton}" Margin="0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</dialogs:WindowHost>
