<dialogs:WindowHost x:Class="FocLauncherHost.Dialogs.UpdateSuccessDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:FocLauncherHost.Dialogs"
             Width="560" Height="320" MinHeight="320" Background="Transparent" Foreground="{DynamicResource TextBrush}"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <FrameworkElement.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </FrameworkElement.Resources>

    <Border Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="14" Padding="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.42" Color="#FF000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" CornerRadius="14,14,0,0" Padding="16,10" MouseLeftButtonDown="MoveWindow">
                <StackPanel>
                    <TextBlock Text="EMPIRE AT WAR Launcher" Foreground="{DynamicResource TitleBarTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Launcher update" Foreground="{DynamicResource TitleBarTextBrush}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="24,22,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="12" Background="{DynamicResource SelectedBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                    <TextBlock Text="✓" Foreground="{DynamicResource SelectionTextBrush}" FontSize="34" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Update installed" Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="The latest launcher files are ready. Your settings and presets were kept."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Border HorizontalAlignment="Left" Background="{DynamicResource SelectedBrush}" CornerRadius="8" Padding="10,5" Margin="0,12,0,0">
                        <TextBlock Text="READY TO CONTINUE" Foreground="{DynamicResource SelectionTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,14,14" Padding="18,12">
                <Grid>
                    <TextBlock Text="EMPIRE AT WAR Launcher" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Content="Continue" Style="{StaticResource DialogButton}"
                            IsDefault="True" IsCancel="True"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</dialogs:WindowHost>
