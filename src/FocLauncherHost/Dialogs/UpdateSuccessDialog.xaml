<dialogs:WindowHost x:Class="FocLauncherHost.Dialogs.UpdateSuccessDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:FocLauncherHost.Dialogs"
             Width="540" MinHeight="250" Background="Transparent" Foreground="#FFF2F7FF"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <FrameworkElement.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Foreground" Value="#FFF4F8FF"/>
            <Setter Property="Background" Value="#FF287BB8"/>
            <Setter Property="BorderBrush" Value="#FF65C5F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF3C9ED6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF1C5C8C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </FrameworkElement.Resources>

    <Border Background="#F2161E2A" BorderBrush="#596B8AA7" BorderThickness="1" CornerRadius="18" Padding="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.42" Color="#FF000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#321D3448" CornerRadius="17,17,0,0" Padding="22,16">
                <StackPanel>
                    <TextBlock Text="EMPIRE AT WAR" Foreground="#FFBBDFFF" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="Launcher update" Foreground="#FFF4F8FF" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="24,22,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="18" Background="#242AAB78"
                        BorderBrush="#5C6EE7B7" BorderThickness="1">
                    <TextBlock Text="✓" Foreground="#FF9FF5CA" FontSize="34" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Update installed" Foreground="#FFF4F8FF" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="The latest launcher files are ready. Your settings and presets were kept."
                               Foreground="#BFD4E3F1" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Border HorizontalAlignment="Left" Background="#242AAB78" CornerRadius="9" Padding="10,5" Margin="0,12,0,0">
                        <TextBlock Text="READY TO CONTINUE" Foreground="#FFB5F6D1" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="#26121A28" CornerRadius="0,0,17,17" Padding="20,12">
                <Grid>
                    <TextBlock Text="EMPIRE AT WAR Launcher" Foreground="#809DB5CD" FontSize="10" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Content="Continue" Style="{StaticResource DialogButton}"
                            IsDefault="True" IsCancel="True"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</dialogs:WindowHost>
