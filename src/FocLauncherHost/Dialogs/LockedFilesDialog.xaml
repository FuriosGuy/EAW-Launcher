<dialogs:WindowHost x:Class="FocLauncherHost.Dialogs.LockedFilesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:restart="clr-namespace:TaskBasedUpdater.Restart;assembly=TaskBasedUpdater"
             xmlns:dialogs="clr-namespace:FocLauncherHost.Dialogs"
             xmlns:converters="clr-namespace:FocLauncherHost.Converters"
             mc:Ignorable="d" d:DesignHeight="360" d:DesignWidth="600"
             Width="600" MinHeight="330" Background="Transparent" Foreground="{DynamicResource TextBrush}"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <FrameworkElement.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:LockingProcessInfoTextConverter x:Key="LockingProcessInfoTextConverter"/>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="104"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="16,6"/><Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/></Trigger>
                            <Trigger Property="IsCancel" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PanelBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ProcessItemTemplate" DataType="{x:Type restart:ILockingProcessInfo}">
            <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                <TextBlock Text="{Binding ., Converter={StaticResource LockingProcessInfoTextConverter}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </DataTemplate>
    </FrameworkElement.Resources>

    <Border Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="14" SnapsToDevicePixels="True">
        <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.42" Color="#FF000000"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" CornerRadius="14,14,0,0" Padding="16,10">
                <StackPanel>
                    <TextBlock Text="EMPIRE AT WAR Launcher" Foreground="{DynamicResource TitleBarTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Files required for update are locked" Foreground="{DynamicResource TitleBarTextBrush}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="1" Margin="24,20,24,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="62" Height="62" CornerRadius="12" Background="{DynamicResource IconBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" VerticalAlignment="Top">
                    <TextBlock Text="!" Foreground="{DynamicResource PrimaryBrush}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding Description}" Foreground="{DynamicResource TextBrush}" FontSize="13" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Text="Close these processes before continuing." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,6,0,10"/>
                    <ScrollViewer Grid.Row="2" MaxHeight="142" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Processes}" ItemTemplate="{StaticResource ProcessItemTemplate}"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,14,14" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button IsDefault="True" Content="_Retry" Style="{StaticResource DialogButton}" Click="OnRetry" Visibility="{Binding Retry, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="{Binding ButtonText}" Style="{StaticResource DialogButton}" Click="OnProceed"/>
                    <Button IsCancel="True" Content="_Abort Update" Style="{StaticResource DialogButton}" Margin="0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</dialogs:WindowHost>
