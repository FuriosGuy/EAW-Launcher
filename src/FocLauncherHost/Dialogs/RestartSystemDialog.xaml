<dialogs:WindowHost x:Class="FocLauncherHost.Dialogs.RestartSystemDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dialogs="clr-namespace:FocLauncherHost.Dialogs"
             mc:Ignorable="d" d:DesignHeight="330" d:DesignWidth="600"
             Width="600" MinHeight="310" Background="Transparent" Foreground="{DynamicResource TextBrush}"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <FrameworkElement.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="104"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="18,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </FrameworkElement.Resources>

    <Border Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="14" SnapsToDevicePixels="True">
        <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.42" Color="#FF000000"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" CornerRadius="14,14,0,0" Padding="16,10">
                <StackPanel>
                    <TextBlock Text="EMPIRE AT WAR Launcher" Foreground="{DynamicResource TitleBarTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Launcher startup error" Foreground="{DynamicResource TitleBarTextBrush}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="1" Margin="24,22,24,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="62" Height="62" CornerRadius="12" Background="{DynamicResource IconBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" VerticalAlignment="Top">
                    <TextBlock Text="!" Foreground="{DynamicResource PrimaryBrush}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="A critical error occurred" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="While initializing launcher, an exception occurred:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0" MaxHeight="92">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding ExceptionMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="Restart Windows, then try launching again." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,14,14" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button IsDefault="True" IsCancel="True" Content="OK" Style="{StaticResource DialogButton}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</dialogs:WindowHost>
