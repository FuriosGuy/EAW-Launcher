<dialogs:WindowHost x:Class="FocLauncherHost.Dialogs.ExceptionWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:exceptionHandling="clr-namespace:FocLauncherHost.ExceptionHandling"
            xmlns:dialogs="clr-namespace:FocLauncherHost.Dialogs"
            xmlns:converters="clr-namespace:FocLauncherHost.Converters"
            MinHeight="290" Width="620" Background="Transparent" Foreground="{DynamicResource TextBrush}"
            DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <FrameworkElement.Resources>
        <exceptionHandling:StackTraceToShortMessageConverter x:Key="StackTraceToShortMessageConverter"/>
        <exceptionHandling:ExceptionToTextConverter x:Key="ExceptionToTextConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" BasedOn="{StaticResource DialogButton}" TargetType="Button">
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </FrameworkElement.Resources>

    <Border Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="14" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" CornerRadius="14,14,0,0"
                    Padding="16,10" MouseLeftButtonDown="OnTitleBarMouseDown">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="EMPIRE AT WAR Launcher" Foreground="{DynamicResource TitleBarTextBrush}"
                               FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource CloseButton}"
                            Foreground="{DynamicResource TitleBarTextBrush}" Click="OnClose" ToolTip="Close"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="24,22,24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="96" Height="96" CornerRadius="12"
                        Background="{DynamicResource IconBackgroundBrush}" Padding="4" VerticalAlignment="Top">
                    <Image Stretch="Uniform">
                        <Image.Source>
                            <BitmapImage UriSource="../Resources/sadTrooper.jpeg"/>
                        </Image.Source>
                    </Image>
                </Border>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Oh no, something went wrong!" Foreground="{DynamicResource TextBrush}"
                               FontFamily="Segoe UI" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Exception, Converter={StaticResource ExceptionToTextConverter}}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Segoe UI" FontSize="13"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Text="Server stack trace" Foreground="{DynamicResource MutedTextBrush}"
                               FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Margin="0,18,0,4"/>
                    <TextBlock Text="{Binding Exception.StackTrace, Converter={StaticResource StackTraceToShortMessageConverter}}"
                               Foreground="{DynamicResource MutedTextBrush}" FontFamily="Consolas" FontSize="10"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="54"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="0,0,14,14" Padding="18,12">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Save the full error log from the button." Foreground="{DynamicResource MutedTextBrush}"
                               FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="Save stack trace" Style="{StaticResource DialogButton}"
                                Visibility="{Binding Exception.StackTrace, Converter={StaticResource NullToVisibilityConverter}}"
                                Click="OnSaveStackTrace"/>
                        <Button IsCancel="True" IsDefault="True" Content="OK" Style="{StaticResource DialogButton}"
                                Click="OnClose"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</dialogs:WindowHost>
