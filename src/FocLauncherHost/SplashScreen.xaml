<Window x:Class="FocLauncherHost.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:FocLauncher.Converters;assembly=FocLauncher.Core"
        xmlns:converters1="clr-namespace:FocLauncherHost.Converters"
        ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="560" Height="400" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <FrameworkElement.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters1:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter"/>
        <converters1:LauncherTypeNameConverter x:Key="LauncherTypeNameConverter"/>
        <converters:BooleanAndConverter x:Key="BooleanAndConverter"/>

        <Storyboard x:Key="HideAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0.45" To="0.0">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.45" Value="{x:Static Visibility.Hidden}"/>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="LoadingPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="LoadingDotScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.22" Duration="0:0:0.7"/>
            <DoubleAnimation Storyboard.TargetName="LoadingDotScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.22" Duration="0:0:0.7"/>
            <DoubleAnimation Storyboard.TargetName="LoadingGlow" Storyboard.TargetProperty="Opacity"
                             From="0.2" To="0.75" Duration="0:0:0.7"/>
        </Storyboard>

        <Style x:Key="SplashProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Background" Value="#32131D2D"/>
            <Setter Property="Foreground" Value="#FF76C7FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border Background="{TemplateBinding Foreground}" CornerRadius="3"
                                    Width="140" HorizontalAlignment="Left">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="IndicatorTransform" X="-140"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="IndicatorTransform"
                                                             Storyboard.TargetProperty="X" From="-140" To="560"
                                                             Duration="0:0:1.35"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </FrameworkElement.Resources>

    <Border Margin="10" Background="#F20E1520" BorderBrush="#586B8AA6" BorderThickness="1"
            CornerRadius="22" Padding="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.45" Color="#FF000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#301C2B3D" CornerRadius="20,20,0,0" Padding="24,20,24,16">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="EMPIRE AT WAR" Foreground="#FFBBDFFF" FontFamily="Segoe UI"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Launcher" Foreground="#FFF4F8FF" FontFamily="Segoe UI"
                                   FontSize="30" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#261C9FE8"
                            BorderBrush="#5276C7F4" BorderThickness="1" CornerRadius="12" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#FF7ED6FF" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="STARTING" Foreground="#FFD8F3FF" FontFamily="Segoe UI"
                                       FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,18,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="220" Height="220" CornerRadius="20" Background="#22101A28"
                        BorderBrush="#345E7EA0" BorderThickness="1" HorizontalAlignment="Left">
                    <Grid ClipToBounds="True">
                        <Image Source="Resources/splash.png" Stretch="Uniform" Margin="10"
                               RenderOptions.BitmapScalingMode="Fant"/>
                        <Border VerticalAlignment="Bottom" Height="72">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00101A28" Offset="0"/>
                                    <GradientStop Color="#E6101826" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Preparing your launcher" Foreground="#FFF4F8FF" FontFamily="Segoe UI"
                               FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Loading games, presets, and launcher services." Foreground="#BFD3E0F0"
                               FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,22"/>
                    <Border Background="#26162130" BorderBrush="#334C6985" BorderThickness="1"
                            CornerRadius="12" Padding="14,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,9,0">
                                    <Ellipse x:Name="LoadingGlow" Fill="#FF69C9FF" Opacity="0.35"/>
                                    <Ellipse Width="7" Height="7" Fill="#FFB9ECFF" HorizontalAlignment="Center"
                                             VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="LoadingDotScale"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                                <TextBlock Text="Working in the background" Foreground="#FFE5F2FF" FontFamily="Segoe UI"
                                           FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <ProgressBar Style="{StaticResource SplashProgress}" IsIndeterminate="True" Margin="0,12,0,0"/>
                            <TextBlock Text="{Binding ProgressText}" Foreground="#9FBBD0E5" FontFamily="Segoe UI"
                                       FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="#26121B29" CornerRadius="0,0,20,20" Padding="24,12">
                <Grid>
                    <TextBlock Text="EMPIRE AT WAR Launcher" Foreground="#8FAEC5DC" FontFamily="Segoe UI" FontSize="10"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Icon © Exhumed" Foreground="#6F91A8BF" FontFamily="Segoe UI" FontSize="9"
                                   VerticalAlignment="Center"/>
                        <Button Content="Cancel" MinWidth="76" Height="28" Margin="16,0,0,0" Padding="12,3"
                                IsEnabled="{Binding Cancelable}" Click="OnCancel"
                                Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource LoadingPulse}"/>
        </EventTrigger>
    </Window.Triggers>
</Window>
