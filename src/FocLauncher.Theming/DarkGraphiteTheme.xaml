<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DarkTheme.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Color x:Key="AppBackgroundColor">#0B0D10</Color>
    <Color x:Key="SidebarColor">#07090C</Color>
    <Color x:Key="PanelColor">#15191F</Color>
    <Color x:Key="PanelRaisedColor">#1E242D</Color>
    <Color x:Key="BorderColor">#303946</Color>
    <Color x:Key="BorderStrongColor">#596579</Color>
    <Color x:Key="PrimaryColor">#C4D0E2</Color>
    <Color x:Key="PrimaryHoverColor">#E5EBF5</Color>
    <Color x:Key="PrimaryPressedColor">#8192AB</Color>
    <Color x:Key="AccentColor">#7C8EA8</Color>
    <Color x:Key="AccentHoverColor">#A8B7CC</Color>
    <Color x:Key="SelectedColor">#344154</Color>
    <Color x:Key="SelectedInactiveColor">#29333F</Color>
    <Color x:Key="HoverColor">#293442</Color>
    <Color x:Key="HoverBorderColor">#5D6E87</Color>
    <Color x:Key="ControlHoverBorderColor">#8C9BB1</Color>
    <Color x:Key="OverlayColor">#171C23</Color>
    <Color x:Key="DropIndicatorColor">#E5EBF5</Color>
    <Color x:Key="TitleBarColor">#07090C</Color>
    <Color x:Key="TitleBarTextColor">#E5E7EB</Color>
    <Color x:Key="WindowGlyphColor">#A8B7CC</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="{StaticResource PanelRaisedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}"/>
    <SolidColorBrush x:Key="SelectedInactiveBrush" Color="{StaticResource SelectedInactiveColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="HoverBorderBrush" Color="{StaticResource HoverBorderColor}"/>
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="{StaticResource ControlHoverBorderColor}"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}"/>
    <SolidColorBrush x:Key="DropIndicatorBrush" Color="{StaticResource DropIndicatorColor}"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}"/>
    <SolidColorBrush x:Key="TitleBarTextBrush" Color="{StaticResource TitleBarTextColor}"/>
    <SolidColorBrush x:Key="WindowGlyphBrush" Color="{StaticResource WindowGlyphColor}"/>
</ResourceDictionary>
