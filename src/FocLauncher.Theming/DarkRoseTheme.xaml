<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DarkTheme.xaml"/></ResourceDictionary.MergedDictionaries>
    <Color x:Key="AppBackgroundColor">#180A14</Color><Color x:Key="SidebarColor">#0F050D</Color><Color x:Key="PanelColor">#281221</Color><Color x:Key="PanelRaisedColor">#3B1A31</Color>
    <Color x:Key="BorderColor">#6C3258</Color><Color x:Key="BorderStrongColor">#A95085</Color><Color x:Key="PrimaryColor">#F5A9D0</Color><Color x:Key="PrimaryHoverColor">#FFD0E7</Color>
    <Color x:Key="PrimaryPressedColor">#CE5A9E</Color><Color x:Key="AccentColor">#D946A6</Color><Color x:Key="AccentHoverColor">#EC6AC3</Color><Color x:Key="SelectedColor">#7A2F63</Color>
    <Color x:Key="SelectedInactiveColor">#56264A</Color><Color x:Key="HoverColor">#5D2C4E</Color><Color x:Key="HoverBorderColor">#A2467C</Color><Color x:Key="ControlHoverBorderColor">#D57DAF</Color>
    <Color x:Key="OverlayColor">#2F1727</Color><Color x:Key="DropIndicatorColor">#FFD0E7</Color><Color x:Key="TitleBarColor">#0F050D</Color><Color x:Key="TitleBarTextColor">#FFE9F3</Color><Color x:Key="WindowGlyphColor">#F0A1C9</Color>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/><SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/><SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/><SolidColorBrush x:Key="PanelRaisedBrush" Color="{StaticResource PanelRaisedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/><SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/><SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/><SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/><SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/><SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/><SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}"/><SolidColorBrush x:Key="SelectedInactiveBrush" Color="{StaticResource SelectedInactiveColor}"/><SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="HoverBorderBrush" Color="{StaticResource HoverBorderColor}"/><SolidColorBrush x:Key="ControlHoverBorderBrush" Color="{StaticResource ControlHoverBorderColor}"/><SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}"/><SolidColorBrush x:Key="DropIndicatorBrush" Color="{StaticResource DropIndicatorColor}"/><SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}"/><SolidColorBrush x:Key="TitleBarTextBrush" Color="{StaticResource TitleBarTextColor}"/><SolidColorBrush x:Key="WindowGlyphBrush" Color="{StaticResource WindowGlyphColor}"/>
</ResourceDictionary>
