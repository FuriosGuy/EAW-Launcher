<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="LauncherBrushes.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Color x:Key="AppBackgroundColor">#F5F7FA</Color>
    <Color x:Key="SidebarColor">#FFFFFF</Color>
    <Color x:Key="PanelColor">#FFFFFF</Color>
    <Color x:Key="PanelRaisedColor">#F1F4F8</Color>
    <Color x:Key="BorderColor">#D7DEE8</Color>
    <Color x:Key="BorderStrongColor">#B7C2D0</Color>
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="PrimaryHoverColor">#1D4ED8</Color>
    <Color x:Key="PrimaryPressedColor">#1E40AF</Color>
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="AccentHoverColor">#3B82F6</Color>
    <Color x:Key="TextColor">#172033</Color>
    <Color x:Key="TextSecondaryColor">#334155</Color>
    <Color x:Key="MutedTextColor">#64748B</Color>
    <Color x:Key="DisabledColor">#E2E8F0</Color>
    <Color x:Key="DisabledTextColor">#94A3B8</Color>
    <Color x:Key="SelectedColor">#DBEAFE</Color>
    <Color x:Key="SelectedInactiveColor">#E5E7EB</Color>
    <Color x:Key="HoverColor">#EFF6FF</Color>
    <Color x:Key="HoverBorderColor">#93C5FD</Color>
    <Color x:Key="ControlHoverBorderColor">#60A5FA</Color>
    <Color x:Key="HandleColor">#F1F4F8</Color>
    <Color x:Key="IconBackgroundColor">#E2E8F0</Color>
    <Color x:Key="OverlayColor">#FFFFFF</Color>
    <Color x:Key="OverlayBackdropColor">#B3E2E8F0</Color>
    <Color x:Key="DropIndicatorColor">#2563EB</Color>
    <Color x:Key="SelectionTextColor">#1E3A8A</Color>
    <Color x:Key="CheckGlyphColor">#172033</Color>
    <Color x:Key="DarkTextColor">#FFFFFF</Color>
    <Color x:Key="TitleBarColor">#FFFFFF</Color>
    <Color x:Key="TitleBarTextColor">#334155</Color>
    <Color x:Key="WindowGlyphColor">#64748B</Color>
    <Color x:Key="WindowInactiveColor">#E2E8F0</Color>
    <Color x:Key="WindowInactiveTextColor">#94A3B8</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="{StaticResource PanelRaisedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}"/>
    <SolidColorBrush x:Key="SelectedInactiveBrush" Color="{StaticResource SelectedInactiveColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="HoverBorderBrush" Color="{StaticResource HoverBorderColor}"/>
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="{StaticResource ControlHoverBorderColor}"/>
    <SolidColorBrush x:Key="HandleBrush" Color="{StaticResource HandleColor}"/>
    <SolidColorBrush x:Key="IconBackgroundBrush" Color="{StaticResource IconBackgroundColor}"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}"/>
    <SolidColorBrush x:Key="OverlayBackdropBrush" Color="{StaticResource OverlayBackdropColor}"/>
    <SolidColorBrush x:Key="DropIndicatorBrush" Color="{StaticResource DropIndicatorColor}"/>
    <SolidColorBrush x:Key="SelectionTextBrush" Color="{StaticResource SelectionTextColor}"/>
    <SolidColorBrush x:Key="CheckGlyphBrush" Color="{StaticResource CheckGlyphColor}"/>
    <SolidColorBrush x:Key="DarkTextBrush" Color="{StaticResource DarkTextColor}"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}"/>
    <SolidColorBrush x:Key="TitleBarTextBrush" Color="{StaticResource TitleBarTextColor}"/>
    <SolidColorBrush x:Key="WindowGlyphBrush" Color="{StaticResource WindowGlyphColor}"/>
    <SolidColorBrush x:Key="WindowInactiveBrush" Color="{StaticResource WindowInactiveColor}"/>
    <SolidColorBrush x:Key="WindowInactiveTextBrush" Color="{StaticResource WindowInactiveTextColor}"/>
</ResourceDictionary>
