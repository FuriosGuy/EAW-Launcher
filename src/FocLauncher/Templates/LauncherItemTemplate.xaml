<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:items="clr-namespace:FocLauncher.Items"
                    xmlns:controls="clr-namespace:FocLauncher.Controls"
                    xmlns:converters="clr-namespace:FocLauncher.Converters">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter"/>
    <converters:LauncherItemMarginConverter x:Key="LauncherItemMarginConverter" />

    <Style x:Key="OrderButtonStyle" TargetType="{x:Type controls:ModOrderButton}">
        <Setter Property="Background" Value="{DynamicResource PanelTranslucentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ModOrderButton}">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="2"
                            RenderTransformOrigin="0.5,0.5"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="HandleScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HandleScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1.08" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="HandleScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1.08" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HandleScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.10"/>
                                        <DoubleAnimation Storyboard.TargetName="HandleScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.10"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RemoveButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PanelTranslucentBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RemoveButtonBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RemoveButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RemoveButtonBorder" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="ItemDataTemplate" DataType="{x:Type items:LauncherItem}">
        <Grid Height="56" Margin="{Binding Depth, Converter={StaticResource LauncherItemMarginConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="Transparent" Padding="0" ClipToBounds="True" VerticalAlignment="Center"
                    Visibility="{Binding IconFile, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                <Image Source="{Binding IconFile, IsAsync=True}" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Margin" Value="12,0,8,0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IconFile}" Value="{x:Null}">
                                <Setter Property="Margin" Value="8,0,8,0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IconFile}" Value="">
                                <Setter Property="Margin" Value="8,0,8,0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding Text, IsAsync=True}" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding ModSource}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding GameObject.Version}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                       VerticalAlignment="Center" Margin="8,0,12,0" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsMod, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:ModOrderButton Content="☰" Width="32" Height="32" Padding="0"
                                         Style="{StaticResource OrderButtonStyle}" ToolTip="Hold and drag to reorder this mod"/>
                <Button Style="{StaticResource RemoveButtonStyle}" ToolTip="Remove mod from preset"
                        Command="{Binding DataContext.RemoveModFromPresetCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{Binding}">
                    <Path Width="14" Height="15" Stretch="Uniform" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.25"
                          Data="M3,4 H13 L12,14 H4 Z M2,2 H14 M5,2 V0 H11 V2 M5,6 V12 M8,6 V12 M11,6 V12"/>
                </Button>
            </StackPanel>
            <Grid.ToolTip>
                <TextBlock TextWrapping="Wrap" MaxWidth="360" Text="{Binding Text}"/>
            </Grid.ToolTip>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
